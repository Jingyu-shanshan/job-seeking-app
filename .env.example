# Copy to .env (git-ignored). Never put real values in this file.

# Model provider key, read only by apps/server
DEEPSEEK_API_KEY=

# PostgreSQL, read only by apps/server. The values below match the local container in CLAUDE.md.
# Production: the Neon direct URL with sslmode=verify-full (the server refuses anything else).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/jsa_dev
# Tests create and drop their own databases on this server, so never point it at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Optional: the API listens on 127.0.0.1:3000 locally and on 0.0.0.0:$PORT when NODE_ENV=production
# PORT=3000
# HOST=127.0.0.1
